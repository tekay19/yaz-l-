# sunucu
DOMAIN=sinavoku.com.tr
APP_URL=https://sinavoku.com.tr
POSTGRES_PASSWORD=degistirin
DATABASE_URL=postgres://sinavoku:degistirin@db:5432/sinavoku
UPLOAD_DIR=/data/uploads

# oturumlar (en az 32 rastgele karakter)
SESSION_SECRET=
# bu adreslerle kayıt olan ya da giriş yapan hesap yönetici olur (virgülle ayrılmış)
ADMIN_EMAILS=

# e-posta (SMTP)
SMTP_URL=smtps://kullanici:parola@smtp.saglayici.com:465
MAIL_FROM="SınavOku <rapor@sinavoku.com.tr>"

# yapay zeka
ANTHROPIC_API_KEY=
# anthropic (varsayılan) ya da openai; openai seçilirse OPENAI_API_KEY ve GRADER_MODEL (ör. gpt-5.5) de verilmeli.
# KVKK: seçilen sağlayıcı, aydınlatma metninde yurt dışı alıcı olarak yazmalı (docs/kvkk-taslak.md).
GRADER_PROVIDER=anthropic
# OPENAI_API_KEY=
GRADER_MODEL=claude-opus-5
GRADER_EFFORT=medium
# ucuz model önce, güçlü model sadece emin olunmayan yerde: belirsiz cevaplı sayfayı yeniden okur ve
# puanlama anahtarını hazırlar (ör. GRADER_MODEL=claude-haiku-5-5 ile claude-sonnet-5-5)
# ESCALATE_PROVIDER=anthropic
# ESCALATE_MODEL=claude-sonnet-5-5
# öğretmene gidecek puanları da yeniden değerlendirsin mi (ölçümde doğruluğu artırmadı, maliyeti ikiye katladı)
# ESCALATE_GRADING=false
# klasik adımların eforu ayrıca ayarlanabilir (boşsa GRADER_EFFORT)
# KLASIK_READ_EFFORT=medium
# KLASIK_GRADE_EFFORT=medium
# bir yapay zekâ çağrısının zaman aşımı (ms); kuyruk kirasından (5 dk) kısa olmalı
READER_TIMEOUT_MS=240000
WORKER_CONCURRENCY=4
# klasik sınav: eval/README.md'deki klasik ölçüm geçip talep doğrulanınca true (Düzeltme.md D1/D4)
KLASIK_ENABLED=false

# ödeme
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# alıcı TCKN'si yerine gönderilen sabit değer; canlıya geçmeden iyzico'yla teyit edin
# IYZICO_DEFAULT_TCKN=11111111111
