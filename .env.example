# sunucu
DOMAIN=sinavoku.com.tr
APP_URL=https://sinavoku.com.tr
POSTGRES_PASSWORD=degistirin
DATABASE_URL=postgres://sinavoku:degistirin@db:5432/sinavoku
UPLOAD_DIR=/data/uploads

# oturumlar (en az 32 rastgele karakter)
SESSION_SECRET=
# bu adreslerle kayıt olan ya da giriş yapan hesap yönetici olur (virgülle ayrılmış)
ADMIN_EMAILS=

# e-posta (SMTP)
SMTP_URL=smtps://kullanici:parola@smtp.saglayici.com:465
MAIL_FROM="SınavOku <rapor@sinavoku.com.tr>"

# yapay zeka
ANTHROPIC_API_KEY=
# anthropic (varsayılan) ya da openai; openai seçilirse OPENAI_API_KEY ve GRADER_MODEL (ör. gpt-5.5) de verilmeli.
# KVKK: seçilen sağlayıcı, aydınlatma metninde yurt dışı alıcı olarak yazmalı (docs/kvkk-taslak.md).
GRADER_PROVIDER=anthropic
# OPENAI_API_KEY=
# Ölçümlerde en iyisi (eval/README.md, 2026-10-08): Haiku 5.5 okur ve her cevabı iki kez puanlar;
# Sonnet 5.5 Haiku'nun emin olmadığı sayfaları yeniden okur ve puanlama anahtarını hazırlar.
# Bunlar varsayılan; yalnızca değiştirmek için yazın.
GRADER_MODEL=claude-haiku-5-5
# ESCALATE_PROVIDER=anthropic   # none: güçlü modeli kapatır
# ESCALATE_MODEL=claude-sonnet-5-5
# öğretmene gidecek puanları da Sonnet yeniden değerlendirsin mi (ölçümde doğruluğu artırmadı, maliyeti ikiye katladı)
# ESCALATE_GRADING=false
# her cevap iki kez puanlanır, puanlar uyuşmazsa öğretmene sorulur; false: tek puanlama
# KLASIK_DOUBLE_GRADE=true
# efor: okuma orta, puanlama yüksek (okumada yüksek efor öğrencinin hatalarını "düzeltti")
# KLASIK_READ_EFFORT=medium
# KLASIK_GRADE_EFFORT=high
# GRADER_EFFORT=medium   # yazılırsa iki klasik adımın da eforunu birden belirler
# bir yapay zekâ çağrısının zaman aşımı (ms); kuyruk kirasından (5 dk) kısa olmalı
READER_TIMEOUT_MS=240000
# yoğun yazılı gerçek kâğıtlarda 8 belirgin hızlı; Anthropic hesabının dakikalık sınırının izin verdiği kadar artırın
WORKER_CONCURRENCY=4
# klasik sınav: eval/README.md'deki klasik ölçüm geçip talep doğrulanınca true (Düzeltme.md D1/D4)
KLASIK_ENABLED=false

# ödeme
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# alıcı TCKN'si yerine gönderilen sabit değer; canlıya geçmeden iyzico'yla teyit edin
# IYZICO_DEFAULT_TCKN=11111111111
